# ===================== App =====================
APP_NAME=agent-os-backend
APP_ENV=development
APP_PORT=8080
AUTO_MIGRATE=true

# ===================== PostgreSQL =====================
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=postgres
PG_DB=agent_os
PG_SSLMODE=disable

# ===================== Redis =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# ===================== JWT =====================
JWT_SECRET=dev-secret-change-me-use-48-plus-bytes-in-production
JWT_ACCESS_TOKEN_MINS=60

# ===================== CORS =====================
CORS_ORIGIN=http://localhost:5173

# ===================== Admission =====================
# protocol | invitation | approval
ADMISSION_POLICY=protocol
ADMISSION_INVITATION_CODE=agentos-dev

# ===================== Object Storage / MinIO =====================
# Backend-to-MinIO endpoint. In Docker Compose API containers this should be minio:9000.
OBJECT_STORAGE_ENDPOINT=localhost:9000
# Client-facing endpoint embedded in presigned URLs. In local host dev this should be localhost:9000.
OBJECT_STORAGE_PUBLIC_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_BUCKET=agentos-objects
OBJECT_UPLOAD_PRESIGN_TTL_SECONDS=900
OBJECT_DOWNLOAD_PRESIGN_TTL_SECONDS=900

