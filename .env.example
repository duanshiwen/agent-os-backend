# ===================== App =====================
APP_NAME=agent-os-backend
APP_ENV=development
APP_PORT=8080
AUTO_MIGRATE=true

# ===================== PostgreSQL =====================
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=postgres
PG_DB=agent_os
PG_SSLMODE=disable

# ===================== Redis =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# ===================== JWT =====================
JWT_SECRET=dev-secret-change-me-use-48-plus-bytes-in-production
JWT_ACCESS_TOKEN_MINS=60

# ===================== CORS =====================
CORS_ORIGIN=http://localhost:5173

# ===================== Admission =====================
# protocol | invitation | approval
ADMISSION_POLICY=protocol
ADMISSION_INVITATION_CODE=agentos-dev

# ===================== Identity Verifier =====================
# Purego + libagentos_ffi.dylib + Rust identity-core
AGENTOS_FFI_LIBRARY_PATH=/Users/yakii/code/agent-os/Infrastructure/connor-agent-core/target/release/libagentos_ffi.dylib
